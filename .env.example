DB_NAME='database_name'
DB_USER='database_user'
DB_PASSWORD='database_password'

# In alternativa si può usare un data source name (DSN)
# Con un DSN si possono rimuovere le variabili DB_NAME, DB_USER, DB_PASSWORD e DB_HOST
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

# Variabili del database opzionali
# DB_HOST='localhost'
# DB_PREFIX='wp_'
# DB_SSL=true

WP_ENV='development'
WP_HOME='https://example.test'
WP_SITEURL="${WP_HOME}/wp"

# Opzionale: WP_ENVIRONMENT_TYPE vale WP_ENV se non impostata
# WP_ENVIRONMENT_TYPE='local'

# Opzionale: disattiva WP-Cron al caricamento delle pagine (eseguilo invece da un cron di sistema)
# DISABLE_WP_CRON=true

# Opzionale: revisioni da conservare (true = illimitate, false/0 = nessuna)
# WP_POST_REVISIONS=10

# Override opzionali del debug (default in development: true)
# Override locali: meglio in .env.local
# WP_DEBUG=false
# WP_DEBUG_DISPLAY=false

# debug.log in development (fuori dalla webroot):
# true/1 o non impostata = logs/debug.log; false/0 = log disattivato; oppure un percorso assoluto
# WP_DEBUG_LOG='/path/to/debug.log'

# Genera le chiavi qui: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
