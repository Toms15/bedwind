{
  "name": "toms15/bedwind",
  "type": "project",
  "license": "MIT",
  "description": "Progetto WordPress basato su Bedrock con il tema Sage, Tailwind CSS e blocchi ACF Pro",
  "homepage": "https://github.com/Toms15/bedwind",
  "authors": [
    {
      "name": "Tommaso Costantini",
      "homepage": "https://github.com/Toms15"
    }
  ],
  "keywords": [
    "bedrock", "composer", "sage", "acf", "tailwindcss", "wordpress", "wp", "wp-config"
  ],
  "support": {
    "issues": "https://github.com/Toms15/bedwind/issues",
    "source": "https://github.com/Toms15/bedwind"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": ["wpackagist-plugin/*", "wpackagist-theme/*"]
    },
    {
      "type": "composer",
      "url": "https://connect.advancedcustomfields.com",
      "only": ["wpengine/*"]
    }
  ],
  "require": {
    "php": ">=8.2",
    "composer/installers": "^2.2",
    "vlucas/phpdotenv": "^5.5",
    "oscarotero/env": "^2.1",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "~7.1.0",
    "roots/wp-config": "^1.0",
    "wpengine/advanced-custom-fields-pro": "^6.5",
    "inpsyde/wp-translation-downloader": "^2.6"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "laravel/pint": "^1.18"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "inpsyde/wp-translation-downloader": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
      "web/app/plugins/{$name}/": ["type:wordpress-plugin"],
      "web/app/themes/{$name}/": ["type:wordpress-theme"]
    },
    "wordpress-install-dir": "web/wp",
    "wp-translation-downloader": {
      "languages": ["it_IT"],
      "languageRootDir": "web/app/languages",
      "excludes": ["wpengine/advanced-custom-fields-pro"]
    }
  },
  "scripts": {
    "lint": [
      "pint --test",
      "@composer --working-dir=web/app/themes/sage lint"
    ],
    "lint:fix": [
      "pint",
      "@composer --working-dir=web/app/themes/sage lint:fix"
    ],
    "analyse": "@composer --working-dir=web/app/themes/sage analyse",
    "test": "@composer --working-dir=web/app/themes/sage test",
    "check": [
      "@composer validate --strict",
      "@composer audit",
      "pint --test",
      "@composer --working-dir=web/app/themes/sage check"
    ]
  },
  "scripts-descriptions": {
    "lint": "Controlla lo stile PHP della root (Pint, preset per) e del tema (Pint, preset laravel).",
    "lint:fix": "Corregge lo stile PHP della root e del tema.",
    "analyse": "Analisi statica del tema con PHPStan.",
    "test": "Test unitari del tema con Pest.",
    "check": "Tutti i controlli PHP: validate --strict, audit e Pint della root, poi composer check del tema."
  }
}
