{
  "name": "sage",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "blocks:manifest": "node resources/scripts/blocks-manifest.js",
    "blocks:manifest:check": "node resources/scripts/blocks-manifest.js --check",
    "icons": "node resources/scripts/icons.js",
    "icons:check": "node resources/scripts/icons.js --check",
    "make:block": "node resources/scripts/make-block.js",
    "test:js": "node --test \"resources/scripts/**/*.test.js\"",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:blade && npm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"resources/css/**/*.css\" \"resources/views/blocks/*/*.css\"",
    "lint:blade": "blade-formatter \"resources/views/**/*.blade.php\" --check-formatted",
    "format": "prettier --write . && npm run format:blade",
    "format:blade": "blade-formatter \"resources/views/**/*.blade.php\" --write",
    "format:check": "prettier --check .",
    "translate": "npm run translate:pot && npm run translate:update",
    "translate:acf": "node resources/scripts/acf-strings.js",
    "translate:pot": "npm run translate:acf && wp i18n make-pot . ./resources/lang/sage.pot --include=\"functions.php,app,resources/views,resources/lang/acf-json.php,theme.json,style.css\" --headers='{\"Report-Msgid-Bugs-To\":\"\",\"Language-Team\":\"\"}'",
    "translate:update": "for file in ./resources/lang/*.po; do wp i18n update-po ./resources/lang/sage.pot $file; done",
    "translate:compile": "npm run translate:mo && npm run translate:php && npm run translate:js",
    "translate:mo": "wp i18n make-mo ./resources/lang ./resources/lang",
    "translate:php": "wp i18n make-php ./resources/lang ./resources/lang",
    "translate:js": "wp i18n make-json ./resources/lang --no-purge --pretty-print"
  },
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@roots/vite-plugin": "^2.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "blade-formatter": "^1.44.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "laravel-vite-plugin": "^3.2.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "overrides": {
    "blade-formatter": {
      "glob": "^14.0.6"
    },
    "editorconfig": "^4.0.1"
  }
}
